{
  "manifest_version": 3,
  "name": "AsliDeal — is that discount real?",
  "version": "1.0.0",
  "description": "Checks an Amazon.in discount against what other Indian stores charge, right on the product page.",
  "host_permissions": ["http://localhost:8000/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open AsliDeal" },
  "content_scripts": [
    {
      "matches": ["*://www.amazon.in/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
